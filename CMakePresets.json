{
  "version": 3,
  "configurePresets": [
    {
      "name": "mingw-base",
      "description": "Target Windows with MinGW",
      "hidden": true,
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++.exe"
      },
      "environment": {
        "PATH": "C:\\msys64\\ucrt64\\bin;$penv{PATH}"
      },
      "vendor": {
        "://microsoft.com": {
          "intelliSenseMode": "linux-gcc-x64"
        }
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "mingw-debug",
      "displayName": "MinGW x64 Debug",
      "description": "Target Windows (64-bit) with MinGW (Debug)",
      "inherits": "mingw-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW x64 Release",
      "description": "Target Windows (64-bit) with MinGW (Release)",
      "inherits": "mingw-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}
